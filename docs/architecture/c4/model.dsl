model {
    operator = person "Operator" "Records lectures and meetings, imports media, edits text and reviews evidence."
    audioOS = softwareSystem "Desktop audio stack" "PulseAudio/PipeWire, ALSA and microphone/system playback devices." "External"
    hub = softwareSystem "Model repositories" "Hugging Face and pinned NVIDIA source/weights; explicit provisioning and optional gated models." "External"
    releases = softwareSystem "GitHub Releases" "Optional release metadata checks; no recorded content is sent." "External"
    aura = softwareSystem "Project AURA" "Local desktop and terminal audio workspace with GPU inference and durable session artifacts." {
        gui = container "Desktop GUI" "Recording, transcript review, settings, diagnostics and local audio splitting." "Python / PyQt6" {
            guiControl = component "Transcription controllers" "Qt controls and background SDK requests; no CUDA ownership." "PyQt6"
            guiSdk = component "Shared SDK (GUI instance)" "AuraClient is imported into the GUI process; it is not a call into a running terminal." "Python / WebSocket"
            splitter = component "Audio splitting" "Qt worker and silence-aware local media splitting." "Python / pydub / FFmpeg"
            diagnostics = component "Runtime diagnostics" "Platform, GPU, audio readiness and optional release check." "Python"
            qtAdapters = component "Retained Qt adapters" "Older model/capture thread interfaces; source compatibility, not the shared-session scheduler." "Python / QThread" "Retained"
        }
        cli = container "Terminal client" "Interactive and batch controls; local or OpenSSH-forwarded connection." "Python / prompt-toolkit" {
            commands = component "CLI commands" "Argument validation, workspace commands, model controls and file locators." "Python"
            terminal = component "Terminal presentation" "Completion, status, audio/backlog graphs and warnings." "prompt-toolkit"
            sdk = component "Shared client SDK" "Authenticated commands, subscriptions, uploads/downloads and audio transport; reused by GUI and producers." "Python / WebSocket"
            nativeLauncher = component "Native capture launcher" "Device preflight and Rust helper lifecycle." "Python / subprocess"
        }
        capture = container "Native capture helper" "Linux device capture, mixed PCM, producer spool, bounded v2 transport and reconnect." "Rust / Tokio / WebSocket" {
            captureIO = component "Capture and mixing" "Source discovery, capture threads, mixing and local durable spool." "Rust"
            captureTransport = component "Producer transport" "Sequence ACKs, generation ownership, pause/Stop boundaries and reconnect." "Rust / Tokio"
            captureCompletion = component "Completion and cleanup" "Ready plus durable frames completes capture; authenticated delivery commit permits spool deletion." "Rust"
        }
        pythonCapture = container "Python capture producer" "Selectable Python producer and platform audio readers; separate capture process." "Python / PulseAudio / PyAudio" {
            pythonIO = component "Audio readers and forwarding" "Capture tracks to a local journal and forward durable frames through the SDK." "Python"
            producerSdk = component "Shared SDK (producer instance)" "Same AuraClient module, loaded in this producer process." "Python / WebSocket"
        }
        service = container "Account session service" "One account owner; authenticated loopback service, sessions, jobs and durable events." "Python / websockets / SQLite" {
            transport = component "Service transport" "Account lock, bearer authentication, control/events, media transfer and PCM endpoints." "Python / WebSocket"
            sessions = component "Durable sessions" "Session state machine, revisions, jobs, stream ownership and raw frame persistence." "Python / SQLite"
            live = component "Live enhancement consumer" "Consume original journal independently; align enhancement, VAD, gaps and ASR ranges." "Python thread"
            repair = component "Enhancement recovery" "One bounded live repair worker plus explicit stopped recovery; retain submitted ranges for review." "Python threads"
            health = component "Enhancement health" "Compare source-aligned original/enhanced speech, request state recovery and expose pending gaps." "Python"
            scheduler = component "Inference supervision" "Spawn one ASR worker, serialize jobs, watch real export progress and bound failures." "Python / multiprocessing"
            retention = component "Delivery commit and retention" "Commit canonical delivery manifests and gate source cleanup after validated export." "Python / filesystem"
            review = component "Transcript review" "Canonical segments, edits, revisions, review events and subtitle exports." "Python"
            audit = component "Content-free audit" "Redacted events, integrity chain, retention and local diagnostics." "Python / JSONL"
            scheduling = component "Scheduling and policy" "Timezone-aware recording timers, validated defaults and output policy." "Python"
        }
        inference = container "Inference process" "GPU ASR lifecycle, live chunk recognition, imported media and explicit refinement/export jobs." "Python / CTranslate2 / CUDA" {
            executor = component "Job dispatcher" "Receive jobs over the multiprocessing pipe; retain loaded ASR runtime." "Python"
            asr = component "ASR runtime" "Breeze by default; optional Linux Parakeet. CUDA required." "faster-whisper / CTranslate2 / NeMo"
            filePipeline = component "Imported media pipeline" "Offline RE-USE, normalization, transcription, formatting and optional diarization." "Python / FFmpeg"
            postprocess = component "Transcript postprocessing" "Chinese punctuation, hotwords, conservative glossary correction and speaker assignment." "Python / optional Transformers"
            diarization = component "Nemotron diarization" "Independent stateful worker; default-on live and complete-file speaker turns." "Isolated Transformers / CUDA"
            media = component "Media conversion" "FFmpeg normalization and bounded private scratch files." "Python / FFmpeg"
            exportExecution = component "Export execution" "Prepare offline RE-USE M4A and fully validate it; return delivery to the service." "Python / FFmpeg"
        }
        enhancement = container "RE-USE process" "Separate Python environment; live, repair and offline instances use fixed NVIDIA weights." "PyTorch / CUDA / FP32" {
            reuseProtocol = component "Worker protocol" "JSONL requests, PCM responses, progress, flush and reset." "Python / stdin / stdout"
            stream = component "Streaming transform" "Centered STFT, overlap-add and exact source length; model state spans ASR segments." "NumPy"
            guard = component "Speech protection" "Source-aligned speech evidence protects surviving model bins inside the worker." "Python / NumPy"
            reuseModel = component "Pinned NVIDIA models" "Real-time RE-USE or offline RE-USE; no raw-audio ASR bypass." "PyTorch / Mamba / CUDA"
            offline = component "Offline windowing" "Full input in five-second windows with 50% overlap, exact output length." "Python"
        }
        evidence = container "Evidence CLI" "Explicit index rebuild and read-only evidence queries over saved artifact packages." "Python / SQLite FTS5" {
            evidenceIndex = component "Evidence index and queries" "Search meetings/segments, locate audio spans and retrieve confirmed actions from compatible artifacts." "Python / SQLite FTS5"
        }
        state = container "Session database" "Sessions, jobs, commands, preferences, events and durable cursors; account-local SQLite WAL." "SQLite" "Store"
        artifacts = container "Session artifact store" "Original/enhanced PCM while required; M4A, text, segments, manifests and review events." "Local filesystem" "Store"
        spools = container "Producer spool" "Original client/server capture frames and manifest; retained until authenticated delivery commit." "Local filesystem" "Store"
        index = container "Evidence search index" "Rebuildable FTS5 index; canonical artifact files remain authoritative." "SQLite FTS5" "Store"
        models = container "Model cache and runtime" "Pinned RE-USE snapshots, isolated environments, ASR weights and optional model caches." "Local filesystem" "Store"
        auditStore = container "Audit event store" "Content-free redacted event records and integrity metadata." "Local JSONL" "Store"
    }
    operator -> gui "Records, reviews and splits media"
    operator -> cli "Controls local or SSH workspace"
    operator -> evidence "Rebuilds index and queries saved evidence"
    gui -> service "Controls shared sessions and receives updates" "Authenticated WebSocket"
    cli -> service "Commands, events and media transfer" "WebSocket / optional SSH tunnel"
    gui -> capture "Starts native Linux capture" "SDK / subprocess"
    cli -> capture "Starts native Linux capture" "SDK / subprocess"
    cli -> pythonCapture "Starts selected Python producer" "Subprocess"
    capture -> audioOS "Captures microphone/system audio" "pactl / parec / native threads"
    pythonCapture -> audioOS "Captures selected audio tracks" "PulseAudio / PyAudio"
    capture -> spools "Persists original frames before upload" "PCM / manifest"
    pythonCapture -> spools "Persists original tracks before upload" "PCM / manifest"
    capture -> service "Streams durable audio and final sequence" "WebSocket v2 PCM / ACKs"
    pythonCapture -> service "Forwards audio and control acknowledgements" "WebSocket PCM"
    service -> state "Persists state, jobs, events and cursors" "SQLite WAL"
    service -> artifacts "Persists source audio, text and manifests" "Filesystem / fsync"
    service -> inference "Dispatches ASR and export work" "multiprocessing pipe"
    service -> enhancement "Enhances live audio and bounded recovery" "JSONL / base64 PCM"
    inference -> enhancement "Enhances full source for import/export" "JSONL / file paths"
    inference -> artifacts "Reads enhanced ranges; writes transcripts and delivery" "Filesystem / FFmpeg"
    enhancement -> artifacts "Reads original input; produces enhanced scratch" "Filesystem"
    inference -> models "Loads fixed ASR model and optional models" "Filesystem"
    enhancement -> models "Loads pinned NVIDIA source and weights" "Filesystem"
    hub -> models "Explicit provisioning; optional model setup" "HTTPS" "Provisioning"
    gui -> releases "Checks release metadata when requested" "HTTPS" "Provisioning"
    service -> auditStore "Writes redacted workflow events" "Local JSONL"
    gui -> artifacts "Splits local media and locates saved outputs" "Filesystem / FFmpeg"
    evidence -> artifacts "Reads compatible saved artifact packages" "Filesystem"
    evidence -> index "Rebuilds or queries local search index" "SQLite FTS5"
    guiControl -> guiSdk "Invokes shared client interface" "Python calls"
    guiSdk -> transport "Commands and events from GUI process" "Authenticated WebSocket"
    commands -> sdk "Controls sessions and transfers media" "Python calls"
    commands -> terminal "Renders status and completion" "Python calls"
    commands -> nativeLauncher "Starts capture helper" "Python calls"
    nativeLauncher -> captureIO "Launches selected capture executable" "JSON stdin"
    sdk -> transport "Commands, subscriptions and PCM" "Authenticated WebSocket"
    diagnostics -> releases "Checks latest release metadata" "HTTPS" "Provisioning"
    captureIO -> captureTransport "Makes durable frames available" "Bounded in-process channel"
    captureIO -> spools "Writes original frames" "Filesystem"
    captureTransport -> transport "Audio packets, ACKs and boundaries" "WebSocket v2"
    captureTransport -> captureCompletion "Checks all captured frames are durable" "Rust calls"
    captureCompletion -> spools "Deletes only after authenticated delivery commit" "Filesystem"
    pythonIO -> producerSdk "Forwards selected producer frames" "Python calls"
    producerSdk -> transport "Producer frames and control acknowledgements" "Authenticated WebSocket"
    pythonIO -> audioOS "Reads selected audio tracks" "PulseAudio / PyAudio"
    pythonIO -> spools "Persists original capture" "Filesystem"
    transport -> sessions "Validates and executes requests" "Python calls"
    sessions -> state "Transactions, revisions, jobs and stream ownership" "SQLite"
    sessions -> artifacts "Durable source appends and canonical writes" "Filesystem / fsync"
    sessions -> live "Starts/drains durable source consumer" "Python thread"
    sessions -> repair "Schedules bounded or explicit recovery" "Condition / thread"
    sessions -> scheduler "Queues fixed-runtime jobs" "Job queue"
    sessions -> retention "Finalizes artifacts and gates cleanup" "Python calls"
    sessions -> review "Prepares canonical segments and edits" "Python calls"
    sessions -> audit "Records content-free events" "Python calls"
    sessions -> scheduling "Validates options and start/stop times" "Python calls"
    live -> artifacts "Reads source, writes source-aligned enhanced journal" "Filesystem"
    live -> reuseProtocol "Pushes source PCM and protection evidence" "JSONL / base64 PCM"
    live -> health "Detects source-speech erasure" "Python calls"
    live -> sessions "Submits only enhanced speech ranges" "Python calls"
    repair -> reuseProtocol "Fresh-state enhancement; at most two attempts" "JSONL / PCM"
    repair -> sessions "Submits uncovered usable enhanced ranges" "Python calls"
    repair -> artifacts "Retains gaps and repair audio" "Filesystem"
    scheduler -> executor "Dispatches jobs and collects results" "multiprocessing pipe"
    executor -> asr "Loads runtime and transcribes enhanced ranges" "Python / CUDA"
    executor -> filePipeline "Imports media or explicitly refines saved audio" "Python calls"
    executor -> exportExecution "Executes stopped recording export" "Python calls"
    filePipeline -> reuseProtocol "Offline enhancement of supplied file" "JSONL / file paths"
    filePipeline -> media "Normalizes enhanced media" "FFmpeg subprocess"
    filePipeline -> asr "Transcribes normalized enhanced audio" "Python / CUDA"
    service -> diarization "Publishes durable original PCM and receives speaker activity" "JSONL / subprocess"
    filePipeline -> diarization "Assigns speaker turns unless explicitly disabled" "Python / GPU"
    filePipeline -> postprocess "Formats punctuation, glossary and speakers" "Python calls"
    asr -> postprocess "Restores live punctuation and validates context" "Python calls"
    asr -> models "Loads selected cached runtime weights" "Filesystem"
    exportExecution -> reuseProtocol "Enhances full original after Stop" "JSONL / file paths"
    exportExecution -> media "Normalizes, encodes and validates final M4A" "FFmpeg"
    exportExecution -> artifacts "Writes validated delivery and scratch" "Filesystem"
    retention -> artifacts "Atomically publishes; keeps originals for pending gaps" "Filesystem / fsync"
    reuseProtocol -> stream "Pushes/flushes exact-length live samples" "Python calls"
    reuseProtocol -> offline "Processes complete offline source" "Python calls"
    reuseProtocol -> guard "Passes aligned source-speech protection" "Python calls"
    stream -> reuseModel "Predicts streaming spectra" "PyTorch / CUDA"
    offline -> reuseModel "Predicts overlapping full-source windows" "PyTorch / CUDA"
    reuseModel -> models "Loads pinned source and weights" "Filesystem"
    review -> artifacts "Writes segments and review events atomically" "Filesystem"
    audit -> auditStore "Writes redacted integrity-linked records" "JSONL"
    splitter -> artifacts "Writes silence-aware media parts" "FFmpeg / filesystem"
    evidenceIndex -> artifacts "Reads canonical packages and verifies identity" "Filesystem"
    evidenceIndex -> index "Explicit rebuild; read-only queries" "SQLite FTS5"
    operator -> evidenceIndex "Runs explicit indexing and queries" "CLI"
    !include deployment.dsl
}
