@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam classBackgroundColor #EDF5F3
skinparam classBorderColor #42697A
skinparam ArrowColor #42697A
hide empty members
title Code - Source-speech protection windows
class "SourceSpeechProtection" as SourceSpeechProtection <<class>> [[https://github.com/JasonLn0711/project_aura/blob/main/src/aura/audio/reuse_policy.py#L9]] {
  hangover = 5120
  push(count, speech)
  protected(start, end)
}
@enduml
