@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam classBackgroundColor #EDF5F3
skinparam classBorderColor #42697A
skinparam ArrowColor #42697A
hide empty members
title Code - Suppression health and retained gaps
class "EnhancementHealth" as EnhancementHealth <<class>> [[https://github.com/JasonLn0711/project_aura/blob/main/src/aura/audio/enhancement_health.py#L6]] {
  window_samples = 48000
  speech_samples = 16000
  observe(count, source_rms, output_rms, source_speech, output_speech)
}
class "pending_gaps" as pending_gaps <<function>> [[https://github.com/JasonLn0711/project_aura/blob/main/src/aura/audio/enhancement_health.py#L66]] {
  (session)
}
class "gap_warning" as gap_warning <<function>> [[https://github.com/JasonLn0711/project_aura/blob/main/src/aura/audio/enhancement_health.py#L70]] {
  (session)
}
gap_warning --> pending_gaps : reports unresolved source ranges
@enduml
