@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam classBackgroundColor #EDF5F3
skinparam classBorderColor #42697A
skinparam ArrowColor #42697A
hide empty members
title Code - Durable session orchestration
class "SessionCore" as SessionCore <<class>> [[https://github.com/JasonLn0711/project_aura/blob/main/src/aura/session_core.py#L78]] {
  directory(sid)
  request(command, args, request_id)
  ingest(sid, sequence, pcm, tracks)
  disconnected(sid, generation)
  events(sid, after)
  close()
}
class "RecordingSession" as RecordingSession <<class>> [[https://github.com/JasonLn0711/project_aura/blob/main/src/aura/audio/recording_session.py#L173]] {
  start(session_dir)
  append_pcm(tracks)
  checkpoint()
  finalize()
}
class "open_stream" as open_stream <<function>> [[https://github.com/JasonLn0711/project_aura/blob/main/src/aura/streaming.py#L17]] {
  (core, sid, producer_id, tracks)
}
class "ingest_packet" as ingest_packet <<function>> [[https://github.com/JasonLn0711/project_aura/blob/main/src/aura/streaming.py#L70]] {
  (core, sid, generation, sequence, pcm, tracks)
}
class "finish" as finish <<function>> [[https://github.com/JasonLn0711/project_aura/blob/main/src/aura/streaming.py#L102]] {
  (core, sid, generation, sequence, action)
}
SessionCore --> RecordingSession : persists frames / finalizes
open_stream --> SessionCore : owns producer generation
ingest_packet --> SessionCore : commits durable cursor
finish --> SessionCore : acknowledges boundary
@enduml
