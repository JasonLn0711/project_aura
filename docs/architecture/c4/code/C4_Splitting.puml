@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam classBackgroundColor #EDF5F3
skinparam classBorderColor #42697A
skinparam ArrowColor #42697A
hide empty members
title Code - Silence-aware media splitting
class "SplitterSettings" as SplitterSettings <<class>> [[https://github.com/JasonLn0711/project_aura/blob/main/src/aura/audio/splitter_pipeline.py#L15]] {
  target_minutes
  tolerance_minutes
  min_silence_len
  silence_margin_db
  fallback_fade_ms
  target_ms()
  tolerance_ms()
}
class "SplitDecision" as SplitDecision <<class>> [[https://github.com/JasonLn0711/project_aura/blob/main/src/aura/audio/splitter_pipeline.py#L32]] {
  cut_point
  used_silence
  search_start
  search_end
}
class "SplitResult" as SplitResult <<class>> [[https://github.com/JasonLn0711/project_aura/blob/main/src/aura/audio/splitter_pipeline.py#L40]] {
  output_paths
}
class "split_audio_file" as split_audio_file <<function>> [[https://github.com/JasonLn0711/project_aura/blob/main/src/aura/audio/splitter_pipeline.py#L99]] {
  (file_path, output_dir, settings, log_callback, progress_callback)
}
class "choose_cut_point" as choose_cut_point <<function>> [[https://github.com/JasonLn0711/project_aura/blob/main/src/aura/audio/splitter_pipeline.py#L65]] {
  (audio, current_pos, settings)
}
split_audio_file --> SplitterSettings : reads configuration
split_audio_file --> choose_cut_point : chooses boundary
choose_cut_point --> SplitDecision : returns cut decision
split_audio_file --> SplitResult : returns output paths
@enduml
